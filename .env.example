# zmzai-auth SSO 中心地址（arena 作为客户端代理其 /api/me 识别登录态）
# 本地开发：auth 应用跑在 3001
NEXT_PUBLIC_AUTH_ORIGIN=http://localhost:3001
# 生产环境改为：https://auth.zmzai.cloud
# 注意：必须与 zmzai-auth 的 SESSION_COOKIE_NAME / AUTH_SECRET / MONGODB_URI 配套，
# 且本地用默认 cookie 名（muzhi_session）即可跨 localhost 端口共享登录态。

# ---- zmzai-sandbox 回测执行（服务端） ----
# 提交策略回测到隔离沙箱执行（内部 Agent API，Bearer 服务密钥）；未配置时自动降级本地引擎
SANDBOX_URL=https://z.zmzai.cloud
# 与 zmzai-sandbox 生产环境 SANDBOX_AGENT_SERVICE_SECRET_CURRENT 一致
SANDBOX_AGENT_SERVICE_SECRET=

# ---- 支付（爱发电，个人创作者可直接接入：实名 + 支付宝/微信收款，无需企业执照） ----
# 注册地址 https://afdian.com ，登录后「创作者中心 → 开发者」获取 USER_ID / API TOKEN。
# 在爱发电创建两个方案（月度 ¥29 / 年度 ¥198），把方案 ID 填到下面两项；不填则按金额判定周期。
# 在开发者后台把 Webhook 回调地址配置为 https://arena.zmzai.cloud/api/billing/webhook 。
# 买家付款时需在留言中填写其 arena 登录邮箱（或 zmz:<userId>），系统自动对账开通 Pro。
# 未配置时 Pro 仅能通过管理员发放（grant）获得，前端显示「内测发放」提示。
AFDIAN_USER_ID=
AFDIAN_TOKEN=
AFDIAN_PLAN_MONTHLY=
AFDIAN_PLAN_YEARLY=
# 站点对外域名（爱发电回调/对账用）；默认 https://arena.zmzai.cloud
SITE_ORIGIN=https://arena.zmzai.cloud
